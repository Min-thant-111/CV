# Application Configuration
APP_NAME=Edge-CV-Traffic-Framework
APP_ENV=development
LOG_LEVEL=INFO

# Video Processing Configuration
VIDEO_SOURCE_PATH=videos/sample_traffic.mp4
ROI_POLYGON=

# YOLO Detector Settings
YOLO_MODEL_PATH=models/yolov8n.pt
CONFIDENCE_THRESHOLD=0.35

# MQTT Broker Configuration
MQTT_BROKER_HOST=localhost
MQTT_BROKER_PORT=1883
MQTT_TOPIC_SIGNAL=traffic/intersection1/signal

# Signal Decision Timings (Seconds)
GREEN_TIME_LOW=30
GREEN_TIME_MED=50
GREEN_TIME_HIGH=70
