# Application Configuration
APP_NAME=Edge-CV-Traffic-Framework
APP_ENV=development
LOG_LEVEL=INFO

# Video Processing Configuration
VIDEO_SOURCE_PATH=videos/sample_traffic.mp4
ROI_POLYGON=

# YOLO Detector Settings
YOLO_MODEL_PATH=yolov8s.pt
YOLO_DEVICE=
CONFIDENCE_THRESHOLD=0.20
DETECTION_IMGSZ=640
DETECTION_IOU=0.45
HIGH_RECALL_TILING=true
TILE_IMGSZ=640
TILE_CONFIDENCE=0.18
TILE_GRID=2
TILE_INTERVAL=15
DETECTION_MEMORY=10
CLASS_HISTORY_FRAMES=12
HEAVY_VEHICLE_MIN_CONFIDENCE=0.30
HEAVY_VEHICLE_MIN_OBSERVATIONS=3
BUS_MIN_OBSERVATIONS=2
CLASS_SWITCH_MARGIN=1.20
SUPPRESS_CAMERA_OVERLAY=true
OVERLAY_TOP_FRACTION=0.24
OVERLAY_LEFT_FRACTION=0.50
FRAME_SKIP=2
UI_UPDATE_EVERY=5

# MQTT Broker Configuration
MQTT_BROKER_HOST=localhost
MQTT_BROKER_PORT=1883
MQTT_TOPIC_SIGNAL=traffic/intersection1/signal

# Signal Decision Timings (Seconds)
DENSITY_LOW_PCT=45
DENSITY_HIGH_PCT=70
GREEN_TIME_LOW=30
GREEN_TIME_MED=50
GREEN_TIME_HIGH=70
